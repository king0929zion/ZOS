# Android 签名配置示例
# 复制此文件为 keystore.properties 并填写您的签名信息
# 注意：keystore.properties 已添加到 .gitignore，不会被提交到 Git

# Keystore 文件路径（相对于项目根目录）
KEYSTORE_FILE=release.keystore

# Keystore 密码
KEYSTORE_PASSWORD=your_keystore_password

# 密钥别名
KEY_ALIAS=browseros

# 密钥密码（通常与 KEYSTORE_PASSWORD 相同）
KEY_PASSWORD=your_key_password

